--========================================================
-- INVENTORY CHECKER
--========================================================

createButton("CHECK FRUIT / TOOL INVENTORY", 122, function()

    local Items = {}

    local Backpack = Player:FindFirstChild("Backpack")
    local Character = Player.Character

    if Backpack then

        for _, item in ipairs(Backpack:GetChildren()) do

            if item:IsA("Tool") then
                table.insert(Items, item.Name)
            end

        end
    end

    if Character then

        for _, item in ipairs(Character:GetChildren()) do

            if item:IsA("Tool") then
                table.insert(Items, item.Name)
            end

        end
    end

    if #Items == 0 then

        notify("INVENTORY", "No visible tools found.")

    else

        notify(
            "INVENTORY",
            table.concat(Items, ", ")
        )

    end
end)

