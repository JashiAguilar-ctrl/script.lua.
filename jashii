--========================================================
-- FRUIT DATABASE
--========================================================

local MythicalFruits = {
    ["Gravity"] = true,
    ["Mammoth"] = true,
    ["T-Rex"] = true,
    ["Dough"] = true,
    ["Shadow"] = true,
    ["Venom"] = true,
    ["Gas"] = true,
    ["Spirit"] = true,
    ["Tiger"] = true,
    ["Yeti"] = true,
    ["Magnet"] = true,
    ["Kitsune"] = true,
    ["Control"] = true,
    ["Dragon"] = true,
    ["Dragon East"] = true,
    ["Dragon West"] = true
}

local SpinHistory = {}

local function normalizeFruit(name)
    name = string.lower(name)
    name = name:gsub("%s+", " ")
    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")
    name = name:gsub("%-", " ")

    return name
end

local function isTrackedFruit(name)
    local normalized = normalizeFruit(name)

    for fruit in pairs(MythicalFruits) do
        if normalizeFruit(fruit) == normalized then
            return true
        end
    end

    return false
end

