createButton("SAVE FRUIT RESULT", 232, function()

    local Fruit = FruitInput.Text

    if Fruit == "" then

        notify("FRUIT TRACKER", "Enter a fruit name first.")
        return

    end

    table.insert(SpinHistory, Fruit)

    if isTrackedFruit(Fruit) then

        notify(
            "TRACKED FRUIT!",
            Fruit .. " recorded in your history."
        )

    else

        notify(
            "FRUIT TRACKER",
            Fruit .. " recorded successfully."
        )

    end

    FruitInput.Text = ""

end)

