createButton("VIEW FRUIT SPIN HISTORY", 279, function()

    if #SpinHistory == 0 then

        notify("FRUIT HISTORY", "No recorded results.")
        return

    end

    local LastResults = {}

    local first = math.max(1, #SpinHistory - 2)

    for i = first, #SpinHistory do
        table.insert(LastResults, SpinHistory[i])
    end

    notify(
        "FRUIT HISTORY",
        "Total: " .. #SpinHistory ..
        " | Recent: " .. table.concat(LastResults, ", ")
